# ==============================================================================
# ASHKRI Academic Solutions — Environment Configuration Specification
# Region: ap-southeast-1 (Singapore)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CANONICAL PUBLIC SITE CONFIGURATION
# ------------------------------------------------------------------------------
# Canonical public base URL for sitemap, robots, and open-graph metadata.
# In production, set to your verified production domain (e.g. https://ashkri.com).
NEXT_PUBLIC_SITE_URL=https://ashkri.com

# Set to 'true' in CI/CD pipelines to fail the build if NEXT_PUBLIC_SITE_URL is missing.
STRICT_CANONICAL_URL=false

# ------------------------------------------------------------------------------
# 2. NEON POSTGRESQL DATABASE (ap-southeast-1)
# ------------------------------------------------------------------------------
# Pooled connection string for Next.js runtime queries (PgBouncer connection pooler)
# Format: postgresql://[user]:[password]@[endpoint-pooler].ap-southeast-1.aws.neon.tech/[dbname]?sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://neondb_owner:npg_placeholder@ep-ashkri-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true

# Direct connection string for Prisma schema migrations and CLI commands
# Format: postgresql://[user]:[password]@[endpoint].ap-southeast-1.aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL=postgresql://neondb_owner:npg_placeholder@ep-ashkri.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. PRIVATE OBJECT STORAGE (ENQUIRY ATTACHMENTS)
# ------------------------------------------------------------------------------
# Storage provider: 'local' (local file system for dev/testing) or 's3' (AWS S3 / Cloudflare R2)
STORAGE_PROVIDER=local
STORAGE_BUCKET=ashkri-enquiry-documents-private
STORAGE_REGION=ap-southeast-1

# S3 / Cloudflare R2 Credentials (required only when STORAGE_PROVIDER=s3)
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=placeholder_access_key
# STORAGE_SECRET_ACCESS_KEY=placeholder_secret_key

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL NOTIFICATIONS
# ------------------------------------------------------------------------------
# Designated corporate administrator recipient for incoming student enquiries
ADMIN_NOTIFICATION_EMAIL=contact@ashkri.com

# Default outgoing sender address
EMAIL_FROM=ASHKRI Academic Solutions <no-reply@ashkri.com>

# Resend API Key (recommended transactional provider)
# RESEND_API_KEY=re_placeholder_xxxxxxxxxxxx

# Alternative SMTP Configuration (used if RESEND_API_KEY is not set)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@ashkri.com
# SMTP_PASS=placeholder_smtp_password

# ------------------------------------------------------------------------------
# 5. SECURITY & ABUSE PREVENTION
# ------------------------------------------------------------------------------
# Secret salt used to generate one-way SHA-256 IP hashes for rate-limiting & spam deterrence
RATE_LIMIT_SALT=replace-with-a-random-32-byte-hex-string-for-production
