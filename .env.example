# Canonical public base URL for sitemap, robots, and open-graph metadata
# In production, omission triggers an explicit deployment warning or halts build when STRICT_CANONICAL_URL=true.
NEXT_PUBLIC_SITE_URL=https://ashkri.com

# Set to 'true' in CI/CD pipelines to fail the build if NEXT_PUBLIC_SITE_URL is not explicitly configured
STRICT_CANONICAL_URL=false

# Database URL (Activates in Phase 3)
# DATABASE_URL=postgresql://user:password@localhost:5432/ashkri_db
